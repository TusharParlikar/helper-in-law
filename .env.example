# All settings use the HIL_ prefix. Defaults shown.
HIL_DB_PATH=data/helperinlaw.db
HIL_OLLAMA_URL=http://localhost:11434
HIL_LLM_MODEL=qwen3:1.7b
# Entailment judge. Must differ from HIL_LLM_MODEL. Empty = deterministic lexical judge.
HIL_JUDGE_MODEL=
HIL_EMBED_MODEL=nomic-embed-text
HIL_USE_LLM=true
HIL_USE_DENSE=true
HIL_EVIDENCE_MIN_SCORE=0.35
HIL_BIND_HOST=127.0.0.1
HIL_CORPUS_AS_OF=2024-12-31
